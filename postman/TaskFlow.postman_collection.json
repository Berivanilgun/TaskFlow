            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', function () { pm.response.to.have.status(400); });",
              "pm.test('Hata kodu: VALIDATION_ERROR', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.error.code).to.eql('VALIDATION_ERROR');",
              "  pm.expect(body.error.message).to.be.a(\"string\");",
              "});",
              "pm.test('Alan hata ayrıntıları var', function () {",
              "  const details = pm.response.json().error.details;",
              "  pm.expect(details).to.be.an(\"array\");",
              "  pm.expect(details.some(function (item) { return item.field === \"title\"; })).to.eql(true);",
              "  pm.expect(details.some(function (item) { return item.field === \"priority\"; })).to.eql(true);",
              "});"
            ]
          }
        }
