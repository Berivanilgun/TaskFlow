              "pm.test('JSON içerik türü', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); });",
              "pm.test('Tam güncelleme ve korunan meta veriler', function () {",
              "  const task = pm.response.json();",
              "  pm.expect(task.id).to.eql(pm.collectionVariables.get(\"taskId\"));",
              "  pm.expect(task.createdAt).to.eql(pm.collectionVariables.get(\"createdAt\"));",
              "  pm.expect(task.title).to.eql(\"Postman güncellenmiş görev\");",
              "  pm.expect(task.description).to.eql(\"\");",
              "  pm.expect(task.assignee).to.eql(\"Ayşe\");",
              "  pm.expect(task.status).to.eql(\"completed\");",
              "  pm.expect(task.priority).to.eql(\"medium\");",
              "  pm.expect(new Date(task.updatedAt).toISOString()).to.eql(task.updatedAt);",
              "  pm.expect(Date.parse(task.updatedAt)).to.be.at.least(Date.parse(task.createdAt));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
