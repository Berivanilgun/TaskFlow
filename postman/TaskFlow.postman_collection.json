{
  "info": {
    "name": "TASKFLOW — Görev Yönetim API",
    "description": "TASKFLOW CRUD ve hata senaryoları. İstekleri 01–11 sırasıyla çalıştırın. POST başarılı olunca taskId ve createdAt koleksiyon değişkenlerine kaydedilir; DELETE yalnızca bu test görevini siler. Önce yerel API sunucusunu npm start ile başlatın. Bu dosya test tanımları içerir; çalıştırılmış Postman sonucu veya ekran görüntüsü değildir.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    },
    {
      "key": "createdAt",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 — Görev oluştur",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"taskId\", \"\");",
              "pm.collectionVariables.set(\"createdAt\", \"\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "pm.test('JSON içerik türü', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); });",
              "pm.test('Görev şeması ve oluşturulan değerler', function () {",
              "  const task = pm.response.json();",
              "  pm.expect(task).to.have.all.keys('id', 'title', 'description', 'assignee', 'status', 'priority', 'createdAt', 'updatedAt');",
              "  pm.expect(task.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i);",
              "  pm.expect(task.title).to.eql(\"Postman test görevi\");",
              "  pm.expect(task.description).to.eql(\"CRUD işlemleri için örnek görev.\");",
              "  pm.expect(task.assignee).to.eql(\"Berivan\");",
              "  pm.expect(task.status).to.eql('pending');",
              "  pm.expect(task.priority).to.eql('high');",
              "  pm.expect(new Date(task.createdAt).toISOString()).to.eql(task.createdAt);",
              "  pm.expect(task.updatedAt).to.eql(task.createdAt);",
              "  pm.expect(pm.response.headers.get('Location')).to.eql('/tasks/' + task.id);",
              "  pm.collectionVariables.set(\"taskId\", task.id);",
              "  pm.collectionVariables.set(\"createdAt\", task.createdAt);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks"
          ]
        },
        "description": "201 ve Location beklenir. Başarılı test, sonraki istekler için taskId ve createdAt değişkenlerini saklar.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman test görevi\",\n  \"description\": \"CRUD işlemleri için örnek görev.\",\n  \"assignee\": \"Berivan\",\n  \"status\": \"pending\",\n  \"priority\": \"high\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "02 — Tüm görevleri listele",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('JSON içerik türü', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); });",
              "pm.test('Görev listede bulunuyor', function () {",
              "  const tasks = pm.response.json();",
              "  pm.expect(tasks).to.be.an(\"array\");",
              "  pm.expect(tasks.some(function (task) { return task.id === pm.collectionVariables.get(\"taskId\"); })).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks"
          ]
        },
        "description": "Liste 200 döner; 01 isteğinde oluşturulan görev bulunmalıdır."
      },
      "response": []
